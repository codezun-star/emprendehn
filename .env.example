# Copia este archivo a .env.local y completa los valores de tu proyecto de Supabase
# (Dashboard → Project Settings → API Keys / Data API).

# URL del proyecto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). La "anon key" legacy también funciona aquí.
# Es pública por diseño: la seguridad la ponen las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL canónica del sitio (sin "/" final). En producción: https://emprendehn.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API key de Resend (re_…) para los correos propios de la app, p. ej. "tu negocio fue
# aprobado". Opcional en desarrollo: sin ella la acción funciona, pero no se envía el correo.
# Solo servidor: NUNCA le pongas el prefijo NEXT_PUBLIC_.
RESEND_API_KEY=

# Opcional: adónde llegan los avisos al admin (nuevo negocio, cambios, reportes).
# Varios separados por coma. Si no se define, se usa codezun@gmail.com.
# CORREO_ADMIN=

# Opcional: CAPTCHA invisible de Cloudflare Turnstile (site key). Actívalo también en
# Supabase → Authentication → Attack Protection DESPUÉS de desplegar con esta variable.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcional: "true" muestra "Continuar con Google" (activa antes el proveedor en Supabase).
# NEXT_PUBLIC_LOGIN_GOOGLE=
